{
    "name": "hidzmusify-tests",
    "private": true,
    "description": "Dev-only test runner. Lives in tests/ so Vercel (which installs only the root package.json) never installs it.",
    "scripts": {
        "test": "node --test --test-force-exit --test-timeout=200000 unit/*.test.mjs e2e/*.test.mjs",
        "test:unit": "node --test unit/*.test.mjs",
        "test:youtube": "node --test --test-force-exit --test-timeout=200000 e2e/youtube.test.mjs"
    },
    "devDependencies": {
        "playwright": "^1.56.1"
    },
    "engines": {
        "node": ">=22"
    }
}
