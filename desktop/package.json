{
  "name": "hidzmusify-desktop",
  "version": "1.0.0",
  "description": "HidzMusify - versi desktop (Windows, macOS, Linux)",
  "main": "main.js",
  "author": "Hidz",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "id.my.hidzproject.hidzmusify",
    "productName": "HidzMusify",
    "files": [
      "main.js",
      "preload.js",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../HidzMusify",
        "to": "HidzMusify",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Audio"
    }
  }
}
