{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.hidzproject.my.id https://hidzproject.my.id http://localhost:* https://*;"
        },
        {
          "key": "Permissions-Policy",
          "value": "autoplay=*, encrypted-media=*, fullscreen=*, picture-in-picture=*, clipboard-write=*"
        }
      ]
    }
  ]
}
